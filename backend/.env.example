# --- Database ---
# Local default is SQLite (no install needed). For Neon/Render Postgres paste the connection string here.
DATABASE_URL=sqlite:///./screen_refer.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_HOURS=12
# Password given to the 3 seeded test users (worker1, worker2, doctor) on first start
SEED_PASSWORD=Test@1234

# --- CORS: comma-separated list of frontend origins ---
CORS_ORIGINS=http://localhost:4200

# --- AI summary (server side only, never in the frontend) ---
# provider: gemini (free tier) or anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
# leave empty to use the default model of the provider
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10
